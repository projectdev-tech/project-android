<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFFFFF"
    tools:context=".profile.AddressFormActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/icon_kiri"
                android:contentDescription="Back button" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alamat Toko"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- Alamat Toko -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alamat Toko"
            android:layout_marginTop="24dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/edtAlamatToko"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Masukan Alamat Toko"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:gravity="top|start"
            android:background="@drawable/spinner_form"
            android:padding="12dp"
            android:scrollbars="vertical" />

        <!-- Provinsi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Provinsi"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <Spinner
            android:id="@+id/spinnerProvinsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <!-- Kota -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kota"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <Spinner
            android:id="@+id/spinnerKota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <!-- Kecamatan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kecamatan"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <Spinner
            android:id="@+id/spinnerKecamatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <!-- Kelurahan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kelurahan"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <Spinner
            android:id="@+id/spinnerKelurahan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/spinner_background"
            android:padding="12dp" />

        <!-- Kode Pos -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kode Pos"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <EditText
            android:id="@+id/edtKodePos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukan Kode Pos"
            android:inputType="number"
            android:background="@drawable/spinner_form"
            android:padding="12dp" />

        <!-- Lokasi Mapping -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lokasi Mapping"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:textColor="#000000" />

        <ImageView
            android:id="@+id/mapImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/map_sample"
            android:background="@drawable/map_placeholder_bg"
            android:contentDescription="Map Image" />

        <!-- Tombol Simpan -->
        <Button
            android:id="@+id/btnSimpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#FFA000"
            android:layout_marginTop="24dp"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginBottom="32dp" />

    </LinearLayout>
</ScrollView>
